# =============================================================================
# Supabase — Next.js
# Copiá este archivo a .env.local y completá los valores desde el dashboard:
# https://supabase.com/dashboard/project/_/settings/api
# =============================================================================

# Project URL (Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# Publishable / anon key (segura para el browser — Settings → API)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Legacy anon key (opcional; usar si preferís el formato JWT clásico)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# Solo servidor — NUNCA exponer con NEXT_PUBLIC_
# Settings → API → service_role (secret)
# -----------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Postgres (ORM / migraciones) — Settings → Database → Connection string
# DATABASE_URL: pooler (Transaction / Session mode)
# DIRECT_URL: conexión directa (migraciones)
# -----------------------------------------------------------------------------
DATABASE_URL=
DIRECT_URL=

# -----------------------------------------------------------------------------
# Contacto — destino de los mails del formulario (/contacto)
# -----------------------------------------------------------------------------
CONTACT_TO_EMAIL=rjtech.lp@gmail.com
# URL pública del sitio (ayuda a FormSubmit en prod). Ej: https://rjtech.com.ar
# NEXT_PUBLIC_SITE_URL=
# Opcional: envío vía Resend (https://resend.com)
# RESEND_API_KEY=
# CONTACT_FROM_EMAIL=RJ Tech <onboarding@resend.dev>
